# Tennis Coach App - Frontend Config
# Just set REACT_APP_PROFILE and API URL!

# Local development
REACT_APP_PROFILE=local
REACT_APP_API_URL=http://localhost:8000/v0

# Production (uncomment and fill in)
# REACT_APP_PROFILE=production
# REACT_APP_API_URL=https://your-api.com/v0
# REACT_APP_SUPABASE_URL=https://...
# REACT_APP_SUPABASE_PUBLISHABLE_KEY=...
