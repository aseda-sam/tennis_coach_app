# Tennis Coach App - Frontend Config
# Just set VITE_PROFILE and API URL!

# Local development
VITE_PROFILE=local
VITE_API_URL=http://localhost:8000/v0

# Production (uncomment and fill in)
# VITE_PROFILE=production
# VITE_API_URL=https://your-api.com/v0
# VITE_SUPABASE_URL=https://...
# VITE_SUPABASE_PUBLISHABLE_KEY=...
