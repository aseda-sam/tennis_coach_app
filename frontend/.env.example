# =============================================================================
# Tennis Coach App - Frontend Environment Configuration
# =============================================================================
# 
# This is an EXAMPLE file. Copy this to .env and fill in your actual values.
# The .env file is gitignored and should NEVER be committed to version control.
#
# Profile-based Configuration:
# - Set REACT_APP_PROFILE to match your backend PROFILE
# - Variables that don't match the profile are ignored
# =============================================================================

# -----------------------------------------------------------------------------
# PROFILE CONFIGURATION (REQUIRED)
# -----------------------------------------------------------------------------
# Must match your backend PROFILE setting
# Options: local, production
# - local: No auth, connects to local backend
# - production: Supabase auth, connects to backend (local or deployed via API_URL)
REACT_APP_PROFILE=local

# -----------------------------------------------------------------------------
# API CONFIGURATION
# -----------------------------------------------------------------------------
# Backend API URL
# For local development:
REACT_APP_API_URL=http://localhost:8000/v0

# For production deployment:
# REACT_APP_API_URL=https://your-api-domain.com/v0

# For local testing with production services (use localhost):
# REACT_APP_API_URL=http://localhost:8000/v0

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Required only when REACT_APP_PROFILE=production
# These are IGNORED when REACT_APP_PROFILE=local

# Supabase project URL
# REACT_APP_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co

# Supabase anon/public key (safe to expose in frontend)
# REACT_APP_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here

# =============================================================================
# LOCAL DEVELOPMENT SETUP (REACT_APP_PROFILE=local)
# =============================================================================
# For local testing, you only need:
# REACT_APP_PROFILE=local
# REACT_APP_API_URL=http://localhost:8000/v0
#
# That's it! Everything else uses defaults:
# - No login screen (auth disabled)
# - Connects to local backend
# - All Supabase variables are ignored
# =============================================================================

# =============================================================================
# LOCAL TESTING WITH PRODUCTION SERVICES (REACT_APP_PROFILE=production)
# =============================================================================
# To test with Supabase auth while connecting to local backend:
# REACT_APP_PROFILE=production
# REACT_APP_API_URL=http://localhost:8000/v0
# REACT_APP_SUPABASE_URL=https://...
# REACT_APP_SUPABASE_PUBLISHABLE_KEY=...
# =============================================================================
