# Tennis Coach App - Simplified Config
# Just set PROFILE and go!

# Local development (default)
PROFILE=local

# Local PostgreSQL (Docker) - defaults to this when PROFILE=local
# Override if using a different PostgreSQL instance
# DATABASE_URL=postgresql://tennis:tennis_dev@localhost:5432/tennis_coach

# Production (uncomment and fill in Supabase vars)
# PROFILE=production
# SUPABASE_DB_URL=postgresql://...
# SUPABASE_URL=https://...
# SUPABASE_SECRET_KEY=...
# SUPABASE_STORAGE_BUCKET=tennis-videos
# SUPABASE_DEMO_BUCKET=demo-videos

# Optional overrides
# DEBUG=true
# REDIS_URL=redis://localhost:6379/0
# RQ_DEQUEUE_TIMEOUT=60
# REDIS_COMMAND_METRICS=false
# REDIS_COMMAND_LOG_EVERY=100
# REDIS_COMMAND_LOG_INTERVAL=60
# SERVICE_TYPE=worker
# MAX_VIDEO_UPLOADS_PER_DAY=20
