# =============================================================================
# Tennis Coach App - Backend Environment Configuration
# =============================================================================
# 
# This is an EXAMPLE file. Copy this to .env and fill in your actual values.
# The .env file is gitignored and should NEVER be committed to version control.
#
# Profile-based Configuration:
# - Set PROFILE to determine which services are used
# - Variables that don't match the profile are ignored
# - You can include all variables - profile acts as a filter
# =============================================================================

# -----------------------------------------------------------------------------
# PROFILE CONFIGURATION (REQUIRED)
# -----------------------------------------------------------------------------
# Options: local, production
# - local: SQLite/Postgres, local storage, auth disabled
# - production: Supabase DB, Supabase storage, Supabase auth
#   (Can be used for local testing with prod services OR deployed production)
PROFILE=local

# -----------------------------------------------------------------------------
# CORE CONFIGURATION
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# API CONFIGURATION
# -----------------------------------------------------------------------------
# API server host (default: 0.0.0.0)
API_HOST=0.0.0.0

# API server port (default: 8000)
API_PORT=8000

# Enable debug mode (default: false)
DEBUG=false

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# For PROFILE=local:
# - Leave DATABASE_URL unset to use SQLite (default)
# - Or set DATABASE_URL to use local Postgres
# DATABASE_URL=postgresql://user:password@localhost:5432/tennis_coach

# For PROFILE=production:
# - SUPABASE_DB_URL is REQUIRED
# SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Required only when PROFILE=production
# These are IGNORED when PROFILE=local

# Supabase project URL
# SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co

# Supabase service role secret key (keep this secret!)
# SUPABASE_SECRET_KEY=your-service-role-secret-key-here

# Supabase storage bucket name
# SUPABASE_STORAGE_BUCKET=videos

# -----------------------------------------------------------------------------
# STORAGE CONFIGURATION
# -----------------------------------------------------------------------------
# Storage type is auto-detected based on PROFILE:
# - PROFILE=local: Uses "local" storage (ignores SUPABASE_STORAGE_BUCKET)
# - PROFILE=production: Uses "supabase" storage (requires SUPABASE_STORAGE_BUCKET)
# You can override this if needed:
# STORAGE_TYPE=local

# Local storage directories (used when STORAGE_TYPE=local)
UPLOAD_DIR=../data/videos/raw
PROCESSED_DIR=../data/videos/processed

# Maximum file size in bytes (default: 104857600 = 100MB)
MAX_FILE_SIZE=104857600

# =============================================================================
# LOCAL DEVELOPMENT SETUP (PROFILE=local)
# =============================================================================
# For local testing, you only need:
# PROFILE=local
#
# That's it! Everything else uses sensible defaults:
# - SQLite database at ../data/database/tennis_coach.db
# - Local file storage in ../data/videos/
# - Auth disabled (mock user)
# - All other settings use defaults
#
# Optional: Set DATABASE_URL if you want to use local Postgres instead of SQLite
# =============================================================================

# =============================================================================
# LOCAL TESTING WITH PRODUCTION SERVICES (PROFILE=production)
# =============================================================================
# To test with Supabase services while running backend locally:
# PROFILE=production
# SUPABASE_DB_URL=postgresql://...
# SUPABASE_URL=https://...
# SUPABASE_SECRET_KEY=...
# SUPABASE_STORAGE_BUCKET=videos
# =============================================================================
